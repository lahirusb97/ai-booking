PORT=3001

# Postgres connection string (Neon or Supabase free tier)
DATABASE_URL=postgres://user:password@host:5432/dbname

# LiveKit server connection (LiveKit Cloud project, or self-hosted livekit-server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI API key, used by the LiveKit voice agent's Realtime API session
OPENAI_API_KEY=

# Secret used to sign JWT access tokens (generate with `openssl rand -hex 48`)
JWT_SECRET="testkey"
